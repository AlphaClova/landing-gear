# HyperCLOVA X — 비워두면 mock 모드로 동작 (개발/테스트용)
HCX_API_KEY=
HCX_API_BASE_URL=https://clovastudio.stream.ntruss.com
HCX_MODEL=HCX-005
HCX_PROMPT_VERSION=v1
HCX_TIMEOUT_SECONDS=8.0
HCX_MAX_RETRIES=2

# 평가 계약: strict면 /answer가 공식 5필드(question_id, question, retrieved_context, think_trace, answer)로 응답
EVAL_SCHEMA_MODE=loose

# 세션
SESSION_TTL_SECONDS=1800

# 성능 목표
FAST_PATH_TIMEOUT_SECONDS=6.0
DEEP_PATH_TIMEOUT_SECONDS=8.0

# 로깅
LOG_LEVEL=INFO

# CORS — 배포 시 C 프론트의 실제 origin으로 제한 (쉼표 없이 JSON 배열 형식)
CORS_ALLOW_ORIGINS=["*"]

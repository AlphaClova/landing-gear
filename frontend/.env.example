# Backend public GET /answer origin. Endpoint-specific clients append their own path.
# Local backend example: http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000
# true selects the in-browser fixture client; false selects the HTTP client.
VITE_USE_MOCK_API=false
# Request timeout in milliseconds. Invalid or missing values fall back to 10000.
VITE_API_TIMEOUT_MS=10000
# Public /answer and /v1/chat client timeout in milliseconds. Invalid or missing values fall back to 30000.
VITE_CHAT_TIMEOUT_MS=120000
# pension-chat Home uses GET /answer when http. mock mode shows a hardcoded DB/DC limitation card.
VITE_CHAT_API_MODE=http

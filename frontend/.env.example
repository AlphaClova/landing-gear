# Backend API origin or proxy prefix. Endpoint-specific clients append their own path.
# Local A API example: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
# true selects the in-browser fixture client; false selects the HTTP client.
VITE_USE_MOCK_API=true
# Request timeout in milliseconds. Invalid or missing values fall back to 10000.
VITE_API_TIMEOUT_MS=10000
